@model IEnumerable<UserManagement.Models.User>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>User Report</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                margin: 30px;
            }

            h1 {
                text-align: center;
                margin-bottom: 5px;
            }

            .report-date {
                text-align: center;
                margin-bottom: 25px;
                color: #555;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid #333;
                padding: 8px;
                text-align: left;
            }

            th {
                font-weight: bold;
            }

            .print-button {
                margin-bottom: 20px;
            }

            @@media print {
                .print-button {
                    display: none;
                }
            }
    </style>
</head>

<body>

    <div class="print-button">
        <button onclick="window.print()">
            Print Report
        </button>
    </div>

    <h1>User Report</h1>

    <div class="report-date">
        Generated on: @DateTime.Now.ToString("dd-MM-yyyy HH:mm")
    </div>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Gender</th>
                <th>Country</th>
                <th>Nationality</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Gender</td>
                    <td>@user.Country</td>
                    <td>@user.Nationality</td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>